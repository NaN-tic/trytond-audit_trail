<tryton>
    <data grouped="1">
        <record model="ir.message" id="msg_subject_audit_trail_notification">
            <field name="text">Audit trail notification</field>
        </record>
        <record model="ir.message" id="msg_body_audit_trail_notification">
            <field name="text">The following audit trail log counters exceeded their configured limits:</field>
        </record>
        <record model="ir.message" id="msg_body_audit_trail_notification_line">
            <field name="text">User: %(user_name)s | Model: %(model)s | Logs: %(logs)s | Limit: %(limit)s | Operation: %(operation)s</field>
        </record>
    </data>
</tryton>
